[Unit]
Description=Sichuan speech API (CosyVoice2-SFT TTS + SenseVoice-SFT ASR)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/whu/chuan
ExecStart=/home/whu/audio/venv/bin/python /home/whu/chuan/src/api_server.py
Restart=always
RestartSec=5
Environment=CUDA_VISIBLE_DEVICES=1
Environment=PORT=8100
# GPU1 only: GPU0 is reserved for ComfyUI

[Install]
WantedBy=default.target
